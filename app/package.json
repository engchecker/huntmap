{
  "name": "hunt-access-nz-app",
  "private": true,
  "version": "2.2.0",
  "description": "Native Android (and later iOS) wrapper for Hunt Access NZ, built with Capacitor.",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
